{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["./worker-configuration.d.ts", "node"]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "worker-configuration.d.ts"
  ]
}
