{
    admin off
    persist_config off
    auto_https off

    log {
        format json
    }

    servers {
        trusted_proxies static private_ranges 100.0.0.0/8
    }
}

:{$PORT:3000} {
    log {
        format json
    }

    handle /health {
        header Content-Type application/json
        respond `{"ok":true}` 200
    }

    handle {
        root * /app/dist
        encode zstd gzip
        try_files {path} /index.html
        file_server
    }
}
