{
  "name": "talent-on",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "supabase:check": "node scripts/check-supabase.mjs",
    "supabase:bootstrap": "tsx scripts/bootstrap-supabase-admin.mjs",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:demo": "vite --mode demo --port=3001 --host=0.0.0.0",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "check": "tsc --noEmit",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "emulators": "firebase emulators:start",
    "test:rules": "vitest run --config tests/vitest.config.ts",
    "test:emulators": "firebase emulators:exec --only auth,firestore \"npm run test:rules\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase-tools": "^15.28.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.11"
  }
}
